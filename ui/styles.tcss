/* =====================================================================
   iico-agent — styles.tcss
   ===================================================================== */

Screen {
    background: $background;
}

/* --------------------------------------------------------------------- 
   Barra de estado del agente (siempre visible debajo del Header)
   --------------------------------------------------------------------- */

#agent-status-bar {
    height: 1;
    background: #001628;
    padding: 0 1;
    border-bottom: solid #004a98;
}

#state-icon {
    width: auto;
    margin-right: 1;
}

#state-label {
    color: #66a3ff;
    width: auto;
}

#state-task {
    color: $text-muted;
    width: 1fr;
}

/* --------------------------------------------------------------------- 
   Workspace: explorador | chat (layout horizontal principal)
   --------------------------------------------------------------------- */

#workspace {
    width: 100%;
    height: 1fr;
}

/* --------------------------------------------------------------------- 
   Panel izquierdo: explorador de archivos
   --------------------------------------------------------------------- */

#file-explorer {
    width: 30;
    min-width: 24;
    max-width: 48;
    height: 100%;
    border-right: solid #004a98;
    background: #001a33;
    padding: 0;
}

#explorer-title {
    background: #004a98;
    color: $text;
    width: 100%;
    padding: 0 1;
    text-align: center;
    text-style: bold;
}

#explorer-root-label {
    padding: 0 1;
    color: $text-muted;
    width: 100%;
    overflow: hidden;
}

#explorer-buttons {
    layout: horizontal;
    width: 100%;
    height: 3;
    margin: 0;
}

#btn-up-dir {
    width: auto;
    height: 3;
    min-width: 6;
    margin: 0;
    border: none;
}

#btn-set-root {
    width: 1fr;
    height: 3;
    margin: 0;
    border: none;
}

DirectoryTree {
    height: 1fr;
    background: #001a33;
    border: none;
    padding: 0 1;
}

DirectoryTree > .tree--guides {
    color: #004a98;
}

/* --------------------------------------------------------------------- 
   Panel derecho: chat
   --------------------------------------------------------------------- */

#chat-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#logo {
    text-align: center;
    margin-bottom: 1;
}

#chat-area {
    width: 100%;
    height: 1fr;
    border: solid #004a98;
    padding: 1;
    margin-bottom: 1;
    overflow-y: scroll;
}

ChatMessage {
    margin-bottom: 1;
    width: 100%;
}

#welcome-msg {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

/* --------------------------------------------------------------------- 
   Input y autocompletado
   --------------------------------------------------------------------- */

#chat-input {
    width: 100%;
    border: round #004a98;
    background: $boost;
}

#chat-input:focus {
    border: round #66a3ff;
}

#cmd-options {
    display: none;
    height: auto;
    max-height: 6;
    margin-bottom: 1;
    border: solid #004a98;
    background: $boost;
}
