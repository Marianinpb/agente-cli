Screen {
    background: $background;
}

#agent-status-bar {
    height: 1;
    background: #001a33;
    padding: 0 1;
    border-bottom: solid #004a98;
}

#state-icon {
    width: auto;
    margin-right: 1;
}

#state-label {
    color: #66a3ff;
    width: auto;
}

#state-task {
    color: $text-muted;
    width: 1fr;
}

#main-container {
    width: 100%;
    height: 1fr;
    padding: 1;
}

#logo {
    text-align: center;
    margin-bottom: 1;
}

#chat-area {
    width: 100%;
    height: 1fr;
    border: solid #004a98;
    padding: 1;
    margin-bottom: 1;
    overflow-y: scroll;
}

ChatMessage {
    margin-bottom: 1;
    width: 100%;
}

#chat-input {
    dock: bottom;
    width: 100%;
    border: round #004a98;
    background: $boost;
}

#cmd-options {
    display: none;
    dock: bottom;
    height: auto;
    max-height: 6;
    margin-bottom: 3;
    border: solid #004a98;
    background: $boost;
}

#chat-input:focus {
    border: round #66a3ff;
}

#welcome-msg {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}
